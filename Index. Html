<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07111f">
<title>CyberSentinel AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#07111f;color:#edf7ff;font-family:Arial,sans-serif;padding:18px}
main{max-width:800px;margin:auto}
header{text-align:center;padding:22px 5px}
h1{color:#35e5ff;margin-bottom:8px}
.muted{color:#9bb2c7;font-size:14px;line-height:1.5}
.badge{display:inline-block;background:#123b43;color:#63f5cf;padding:7px 12px;border-radius:20px;font-size:12px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:#101e30;border:1px solid #234158;border-radius:14px;padding:16px;margin:12px 0}
.label{font-size:13px;color:#a9bfd0}
.value{font-size:25px;font-weight:bold;margin-top:10px}
.cyan{color:#35e5ff}.green{color:#63f5cf}.yellow{color:#ffd166}
button{background:#22d3e6;color:#06121d;border:0;border-radius:8px;padding:12px 15px;font-weight:bold;margin:6px 4px 4px 0}
textarea{width:100%;min-height:150px;background:#07111f;color:#edf7ff;border:1px solid #34536b;border-radius:9px;padding:12px;font-size:14px}
.result{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.6}
li{margin:10px 0;line-height:1.5}
footer{text-align:center;color:#829caf;font-size:12px;padding:22px 0}
@media(max-width:360px){body{padding:10px}.card{padding:12px}}
</style>
</head>
<body>
<main>
<header>
<div class="badge">CYBERSECURITY • DFIR</div>
<h1>🛡️ CyberSentinel AI</h1>
<p class="muted">Security Operations & Incident Response Dashboard</p>
</header>

<div class="grid">
<div class="card">
<div class="label">SYSTEM STATUS</div>
<div class="value green">● READY</div>
<p class="muted">Analyzer available</p>
</div>
<div class="card">
<div class="label">ANALYSIS MODE</div>
<div class="value cyan">LOG SCAN</div>
<p class="muted">Local text analysis</p>
</div>
<div class="card">
<div class="label">INDICATORS FOUND</div>
<div class="value yellow" id="count">0</div>
<p class="muted">In latest analysis</p>
</div>
<div class="card">
<div class="label">RISK LEVEL</div>
<div class="value green" id="risk">NONE</div>
<p class="muted">Preliminary assessment</p>
</div>
</div>

<section class="card">
<h2>🔍 Security Log Analyzer</h2>
<p class="muted">Paste authorized security logs. The analyzer checks for selected suspicious text patterns.</p>
<textarea id="logs" placeholder="Example: Failed login for user test from unknown host"></textarea>
<br>
<button onclick="analyze()">Analyze Logs</button>
<button onclick="clearAll()" style="background:#2b4054;color:white">Clear</button>
</section>

<section class="card">
<h2>📊 Analysis Report</h2>
<div id="report" class="result muted">Waiting for analysis...</div>
<button id="download" onclick="downloadReport()" hidden>Download Report</button>
</section>

<section class="card">
<h2>🧭 Incident Response Checklist</h2>
<ul>
<li>Preserve relevant logs and record their source and collection time.</li>
<li>Verify alerts against trusted system and security records.</li>
<li>Document actions taken and maintain evidence integrity.</li>
<li>Escalate confirmed incidents to an authorized security professional.</li>
</ul>
</section>

<section class="card">
<h3>⚠️ Prototype Notice</h3>
<p class="muted">This is an educational rule-based prototype, not a validated AI or antivirus product. It does not scan your phone, connect to a SOC, block threats, or prove that an attack occurred. Analyze only logs you are authorized to review. Avoid pasting passwords, tokens, personal data, or confidential logs.</p>
</section>
<footer>CyberSentinel AI • Student DFIR Project</footer>
</main>

<script>
let savedReport = "";

function analyze(){
 const text = document.getElementById("logs").value.trim();
 const out = document.getElementById("report");
 if(!text){
  out.textContent = "Please enter security log text first.";
  return;
 }
 const rules = [
  ["Failed login / authentication issue", /failed login|login failed|authentication failure|invalid password/ig],
  ["Possible privilege-related activity", /privilege escalation|sudo|administrator privileges|root access/ig],
  ["Possible malware alert", /ransomware|keylogger|trojan|malware detected/ig],
  ["Script or encoded-command keyword", /encodedcommand|powershell|base64|bash -c/ig],
  ["Security control disabled", /antivirus disabled|firewall disabled|protection turned off/ig],
  ["Unusual network activity keyword", /unusual outbound connection|connection to unknown host|suspicious outbound/ig]
 ];
 const found = [];
 for(const [name, pattern] of rules){
  const matches = text.match(pattern);
  if(matches) found.push({name:name,count:matches.length});
 }
 let level = "NONE";
 if(found.length >= 3) level = "HIGH";
 else if(found.length >= 1) level = "MEDIUM";

 document.getElementById("count").textContent = found.length;
 const risk = document.getElementById("risk");
 risk.textContent = level;
 risk.className = "value " + (level === "HIGH" ? "yellow" : level === "MEDIUM" ? "yellow" : "green");

 let report = "CYBERSENTINEL AI — PRELIMINARY REPORT\n";
 report += "Time: " + new Date().toLocaleString() + "\n";
 report += "Rule-based indicator count: " + found.length + "\n";
 report += "Preliminary level: " + level + "\n\n";
 if(!found.length){
  report += "No matching indicators found by these rules.\nThis does not prove the system is safe.";
 } else {
  found.forEach((item,i)=>{
   report += (i+1)+". "+item.name+" (matches: "+item.count+")\n";
  });
  report += "\nReview the original logs and verify each finding.";
 }
 report += "\n\nLimitations: Pattern matching only; findings are not proof of compromise.";
 savedReport = report;
 out.textContent = report;
 document.getElementById("download").hidden = false;
}

function clearAll(){
 document.getElementById("logs").value = "";
 document.getElementById("report").textContent = "Waiting for analysis...";
 document.getElementById("count").textContent = "0";
 document.getElementById("risk").textContent = "NONE";
 document.getElementById("risk").className = "value green";
 document.getElementById("download").hidden = true;
 savedReport = "";
}

function downloadReport(){
 if(!savedReport) return;
 const blob = new Blob([savedReport],{type:"text/plain;charset=utf-8"});
 const url = URL.createObjectURL(blob);
 const a = document.createElement("a");
 a.href = url;
 a.download = "CyberSentinel-Incident-Report.txt";
 a.click();
 URL.revokeObjectURL(url);
}
</script>
</body>
</html>