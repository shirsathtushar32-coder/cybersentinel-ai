<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#07111f">
  <title>CyberSentinel AI</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 20px;
      background: #07111f;
      color: #eaf6ff;
      font-family: Arial, sans-serif;
    }
    .container { max-width: 700px; margin: auto; }
    header {
      text-align: center;
      padding: 22px 10px;
      border-bottom: 1px solid #17415a;
    }
    h1 { color: #31e6ff; margin-bottom: 8px; }
    .subtitle { color: #9ab5c8; }
    .badge {
      display: inline-block;
      padding: 6px 12px;
      background: #103342;
      color: #50f5d0;
      border-radius: 20px;
      font-size: 12px;
    }
    .card {
      background: #101e30;
      border: 1px solid #203b52;
      border-radius: 14px;
      padding: 18px;
      margin-top: 18px;
    }
    textarea {
      width: 100%;
      min-height: 160px;
      background: #07111f;
      color: white;
      border: 1px solid #31536a;
      border-radius: 8px;
      padding: 12px;
      resize: vertical;
    }
    button {
      background: #16c9df;
      color: #06121d;
      border: 0;
      padding: 12px 16px;
      margin: 8px 5px 0 0;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }
    .secondary { background: #253e53; color: white; }
    .result { white-space: pre-wrap; line-height: 1.6; overflow-wrap: anywhere; }
    .note { font-size: 13px; color: #9ab5c8; line-height: 1.5; }
    footer { text-align: center; color: #7894a9; font-size: 12px; margin: 25px 0; }
  </style>
</head>
<body>
<div class="container">
  <header>
    <div class="badge">CYBERSECURITY • INCIDENT RESPONSE</div>
    <h1>🛡️ CyberSentinel AI</h1>
    <p class="subtitle">Your Security Incident Analysis Dashboard</p>
  </header>

  <section class="card">
    <h2>📊 Security Log Analyzer</h2>
    <p class="note">Paste a security log below to check for suspicious indicators.</p>
    <textarea id="logs" placeholder="Paste authorized security logs here..."></textarea>
    <br>
    <button onclick="analyzeLogs()">Analyze Logs</button>
    <button class="secondary" onclick="clearLogs()">Clear</button>
  </section>

  <section class="card">
    <h2>🔎 Analysis Report</h2>
    <div id="result" class="result">Waiting for log analysis...</div>
    <button id="downloadBtn" onclick="downloadReport()" hidden>Download Report</button>
  </section>

  <section class="card">
    <h3>⚠️ Important Notice</h3>
    <p class="note">
      This is an educational prototype using basic pattern matching, not a
      validated AI security system. Findings are indicators, not proof of an
      attack. It does not scan your phone, block threats, or delete files.
      Analyze only logs you are authorized to access.
    </p>
  </section>
  <footer>CyberSentinel AI • Student Project Prototype</footer>
</div>

<script>
let lastReport = "";

function analyzeLogs() {
  const logs = document.getElementById("logs").value.trim();
  const result = document.getElementById("result");
  const downloadBtn = document.getElementById("downloadBtn");

  if (!logs) {
    result.textContent = "Please paste some security logs first.";
    downloadBtn.hidden = true;
    return;
  }

  const checks = [
    {
      name: "Repeated failed login attempts",
      pattern: /failed login|login failed|authentication failure|invalid password/ig,
      advice: "Review login records and verify whether the attempts were authorized."
    },
    {
      name: "Possible privilege escalation",
      pattern: /privilege escalation|sudo|administrator privileges|root access/ig,
      advice: "Verify account permissions and confirm whether the activity was expected."
    },
    {
      name: "Possible malware indicator",
      pattern: /ransomware|keylogger|trojan|malware detected/ig,
      advice: "Review the alert with trusted security software and preserve relevant logs."
    },
    {
      name: "Suspicious script or encoded command",
      pattern: /encodedcommand|powershell|base64|bash -c/ig,
      advice: "Check the full command and its context; these terms can also occur in legitimate activity."
    },
    {
      name: "Security control may be disabled",
      pattern: /antivirus disabled|firewall disabled|protection turned off/ig,
      advice: "Verify the security control's current status and review who changed it."
    },
    {
      name: "Potentially unusual network activity",
      pattern: /unusual outbound connection|connection to unknown host|suspicious outbound/ig,
      advice: "Review destination, timestamp, process, and network records."
    }
  ];

  let findings = [];
  checks.forEach(check => {
    const matches = logs.match(check.pattern);
    if (matches) {
      findings.push({
        name: check.name,
        count: matches.length,
        advice: check.advice
      });
    }
  });

  let risk = "LOW";
  if (findings.length >= 3) risk = "HIGH";
  else if (findings.length >= 1) risk = "MEDIUM";

  let report = "CYBERSENTINEL AI — LOG ANALYSIS REPORT\n";
  report += "Date: " + new Date().toLocaleString() + "\n";
  report += "Preliminary indicator level: " + risk + "\n\n";

  if (findings.length === 0) {
    report += "No indicators matching the current rules were found.\n";
    report += "This does not prove that the system is safe.\n";
  } else {
    report += "Potential indicators found: " + findings.length + "\n\n";
    findings.forEach((f, i) => {
      report += (i + 1) + ". " + f.name + "\n";
      report += "   Matching entries: " + f.count + "\n";
      report += "   Suggested review: " + f.advice + "\n\n";
    });
  }

  report += "\nLimitations: Basic pattern matching only; not a validated AI diagnosis.";
  report += "\nTreat results as preliminary and verify them before taking action.";

  lastReport = report;
  result.textContent = report;
  downloadBtn.hidden = false;
}

function clearLogs() {
  document.getElementById("logs").value = "";
  document.getElementById("result").textContent = "Waiting for log analysis...";
  document.getElementById("downloadBtn").hidden = true;
  lastReport = "";
}

function downloadReport() {
  if (!lastReport) return;
  const blob = new Blob([lastReport], {type: "text/plain;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = "CyberSentinel-Incident-Report.txt";
  link.click();
  URL.revokeObjectURL(url);
}
</script>
</body>
</html>
