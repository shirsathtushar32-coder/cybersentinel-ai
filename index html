<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CyberSentinel AI | Security Log Analyzer & IR Triage</title>
  <style>
    /* =====================================================================
       Theme Variables: Dark Navy & Electric Cyan
       ===================================================================== */
    :root {
      --bg-base: #060b14;
      --bg-surface: #0b1426;
      --bg-surface-elevated: #11203b;
      --bg-input: #080f1d;
      
      --border-subtle: #192a47;
      --border-focus: #00f0ff;

      --cyan: #00f0ff;
      --cyan-dim: #00b4c2;
      --cyan-glow: rgba(0, 240, 255, 0.2);

      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-dim: #64748b;

      --risk-low: #10b981;
      --risk-low-bg: rgba(16, 185, 129, 0.15);
      --risk-med: #f59e0b;
      --risk-med-bg: rgba(245, 158, 11, 0.15);
      --risk-high: #ef4444;
      --risk-high-bg: rgba(239, 68, 68, 0.15);

      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, "JetBrains Mono", Consolas, monospace;
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Screen Reader Helper */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    /* =====================================================================
       App Header & Transparency Banner
       ===================================================================== */
    header.app-header {
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 1rem 1.5rem;
    }

    .header-container {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-icon {
      font-size: 1.8rem;
      filter: drop-shadow(0 0 8px var(--cyan-glow));
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-title span {
      color: var(--cyan);
    }

    .brand-subtitle {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .privacy-tag {
      font-size: 0.75rem;
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      background: var(--risk-low-bg);
      color: var(--risk-low);
      border: 1px solid rgba(16, 185, 129, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .privacy-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--risk-low);
      box-shadow: 0 0 6px var(--risk-low);
    }

    /* Transparency Advisory */
    .advisory-banner {
      background: rgba(0, 240, 255, 0.05);
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      padding: 0.65rem 1.5rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .advisory-banner-content {
      max-width: 1400px;
      margin: 0 auto;
    }

    .advisory-banner strong {
      color: var(--cyan);
    }

    /* =====================================================================
       Grid Layout (Desktop & Mobile Responsive)
       ===================================================================== */
    .main-grid {
      max-width: 1400px;
      margin: 1.5rem auto;
      padding: 0 1rem;
      width: 100%;
      display: grid;
      grid-template-columns: 1.35fr 0.9fr;
      gap: 1.5rem;
      flex: 1;
    }

    @media (max-width: 1024px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Panels */
    .panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .panel-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      background: rgba(17, 32, 59, 0.3);
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .panel-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* =====================================================================
       Form Controls & Actions
       ===================================================================== */
    .sample-controls {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .select-dropdown {
      background: var(--bg-input);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      padding: 0.4rem 0.65rem;
      font-size: 0.8rem;
      outline: none;
    }

    .select-dropdown:focus {
      border-color: var(--border-focus);
    }

    .log-textarea {
      width: 100%;
      height: 200px;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      color: #38bdf8;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      padding: 0.85rem;
      line-height: 1.45;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .log-textarea:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 0 2px var(--cyan-glow);
    }

    .actions-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .btn-group {
      display: flex;
      gap: 0.5rem;
    }

    .btn {
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0.5rem 1rem;
      border-radius: var(--radius);
      cursor: pointer;
      border: 1px solid transparent;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--cyan);
      color: #030d1a;
    }

    .btn-primary:hover {
      background: #38f4ff;
      box-shadow: 0 0 12px var(--cyan-glow);
    }

    .btn-secondary {
      background: var(--bg-surface-elevated);
      color: var(--text-main);
      border-color: var(--border-subtle);
    }

    .btn-secondary:hover {
      background: #192e54;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border-color: var(--border-subtle);
    }

    .btn-ghost:hover {
      color: var(--text-main);
      border-color: var(--text-muted);
    }

    .btn-cyan-outline {
      background: rgba(0, 240, 255, 0.08);
      color: var(--cyan);
      border-color: var(--cyan);
    }

    .btn-cyan-outline:hover {
      background: var(--cyan);
      color: #030d1a;
    }

    .btn-sm {
      padding: 0.3rem 0.65rem;
      font-size: 0.75rem;
    }

    .status-msg {
      font-size: 0.8rem;
    }
    .status-msg.error { color: #f87171; }
    .status-msg.success { color: #4ade80; }

    /* =====================================================================
       Analysis Metrics & Risk Display
       ===================================================================== */
    .results-container {
      margin-top: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    @media (max-width: 600px) {
      .metric-grid {
        grid-template-columns: 1fr;
      }
    }

    .metric-card {
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      padding: 0.75rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .metric-title {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .metric-val {
      font-size: 1.4rem;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--cyan);
      margin-top: 0.2rem;
    }

    .risk-badge {
      display: inline-block;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.25rem 0.8rem;
      border-radius: 4px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-top: 0.2rem;
    }

    .risk-low { background: var(--risk-low-bg); color: var(--risk-low); border: 1px solid var(--risk-low); }
    .risk-medium { background: var(--risk-med-bg); color: var(--risk-med); border: 1px solid var(--risk-med); }
    .risk-high { background: var(--risk-high-bg); color: var(--risk-high); border: 1px solid var(--risk-high); }

    .risk-rationale-box {
      background: rgba(17, 32, 59, 0.4);
      border-left: 3px solid var(--cyan);
      padding: 0.75rem;
      border-radius: 0 var(--radius) var(--radius) 0;
      font-size: 0.82rem;
    }

    .risk-rationale-title {
      font-weight: 600;
      color: var(--cyan);
      margin-bottom: 0.2rem;
    }

    /* =====================================================================
       Findings Table
       ===================================================================== */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
    }

    .findings-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
      text-align: left;
    }

    .findings-table th {
      background: var(--bg-surface-elevated);
      padding: 0.65rem 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
      border-bottom: 1px solid var(--border-subtle);
      white-space: nowrap;
    }

    .findings-table td {
      padding: 0.65rem 0.75rem;
      border-bottom: 1px solid var(--border-subtle);
      vertical-align: top;
    }

    .findings-table tr:last-child td {
      border-bottom: none;
    }

    .badge-sev {
      display: inline-block;
      padding: 0.15rem 0.45rem;
      border-radius: 3px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .badge-sev.high { background: var(--risk-high-bg); color: var(--risk-high); }
    .badge-sev.medium { background: var(--risk-med-bg); color: var(--risk-med); }
    .badge-sev.low { background: var(--risk-low-bg); color: var(--risk-low); }

    .evidence-code {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      background: rgba(0, 0, 0, 0.3);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      color: #38bdf8;
      word-break: break-all;
    }

    /* =====================================================================
       IR Checklist & Progress Bar
       ===================================================================== */
    .progress-section {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .progress-percent {
      font-weight: 700;
      color: var(--cyan);
      font-family: var(--font-mono);
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background: var(--bg-input);
      border-radius: 9999px;
      overflow: hidden;
      border: 1px solid var(--border-subtle);
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--cyan-dim), var(--cyan));
      transition: width 0.3s ease;
    }

    .checklist-groups {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .checklist-group {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      background: rgba(17, 32, 59, 0.25);
      overflow: hidden;
    }

    .group-header {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--cyan);
      background: rgba(17, 32, 59, 0.6);
      padding: 0.45rem 0.75rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.82rem;
      cursor: pointer;
      border-bottom: 1px solid rgba(25, 42, 71, 0.4);
      transition: background 0.15s ease;
    }

    .task-item:last-child {
      border-bottom: none;
    }

    .task-item:hover {
      background: rgba(25, 42, 71, 0.3);
    }

    .task-item input[type="checkbox"] {
      margin-top: 3px;
      accent-color: var(--cyan);
      width: 15px;
      height: 15px;
      cursor: pointer;
    }

    .task-item.completed label {
      text-decoration: line-through;
      color: var(--text-dim);
    }

    /* =====================================================================
       Footer
       ===================================================================== */
    footer.app-footer {
      margin-top: auto;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      padding: 1.25rem 1rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      text-align: center;
    }

    .footer-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
  </style>
</head>
<body>

  <!-- Top App Navigation -->
  <header class="app-header">
    <div class="header-container">
      <div class="brand">
        <span class="brand-icon" aria-hidden="true">🛡️</span>
        <div>
          <h1 class="brand-title">CyberSentinel <span>AI</span></h1>
          <p class="brand-subtitle">Client-Side Security Log Analyzer &amp; IR Workbench</p>
        </div>
      </div>
      <div class="header-badges">
        <span class="privacy-tag">
          <span class="privacy-dot"></span> In-Browser Execution (Zero Data Uploads)
        </span>
      </div>
    </div>
  </header>

  <!-- Ethical & Operational Disclaimer -->
  <aside class="advisory-banner" aria-label="Disclaimer">
    <div class="advisory-banner-content">
      <strong>Transparency Notice:</strong> This workbench is an educational, deterministic pattern-matching tool. It is <em>not</em> an antivirus engine, EDR agent, or trained neural network model. Detected indicators represent heuristic leads for triage and do not constitute absolute forensic proof.
    </div>
  </aside>

  <!-- Main Grid Workspace -->
  <main class="main-grid">

    <!-- Column 1: Log Ingestion & Findings -->
    <section class="panel" aria-labelledby="analyzer-title">
      <div class="panel-header">
        <h2 id="analyzer-title" class="panel-title">Security Log Analyzer</h2>
        <div class="sample-controls">
          <label for="sampleSelector" class="sr-only">Choose sample log</label>
          <select id="sampleSelector" class="select-dropdown">
            <option value="" disabled selected>Load preset logs...</option>
            <option value="ssh">SSH Auth Brute-Force Activity</option>
            <option value="sqli">Web SQL Injection Patterns</option>
            <option value="xss">Cross-Site Scripting (XSS) Payloads</option>
            <option value="cmd">Suspicious Shell &amp; Elevation Commands</option>
            <option value="clean">Normal Web Access Logs (Benign)</option>
          </select>
          <button type="button" id="loadSampleBtn" class="btn btn-secondary btn-sm">Load</button>
        </div>
      </div>

      <div class="panel-body">
        <div>
          <label for="logInput" class="sr-only">Raw Log Text</label>
          <textarea
            id="logInput"
            class="log-textarea"
            placeholder="Paste authorized logs here for client-side inspection (e.g. Syslog, Apache/Nginx, Auth.log)..."
            spellcheck="false"
          ></textarea>
        </div>

        <div class="actions-bar">
          <div class="btn-group">
            <button type="button" id="analyzeBtn" class="btn btn-primary">
              ⚡ Analyze Logs
            </button>
            <button type="button" id="clearBtn" class="btn btn-ghost">
              Clear
            </button>
          </div>
          <div id="statusMessage" class="status-msg" aria-live="polite"></div>
        </div>

        <!-- Dynamic Results Container -->
        <div id="resultsWrapper" class="results-container" style="display: none;">
          
          <div class="metric-grid">
            <div class="metric-card">
              <span class="metric-title">Lines Evaluated</span>
              <span id="metricLines" class="metric-val">0</span>
            </div>
            <div class="metric-card">
              <span class="metric-title">Indicators Matched</span>
              <span id="metricMatches" class="metric-val">0</span>
            </div>
            <div class="metric-card">
              <span class="metric-title">Heuristic Risk</span>
              <span id="riskBadge" class="risk-badge risk-low">LOW</span>
            </div>
          </div>

          <div class="risk-rationale-box">
            <div class="risk-rationale-title">Heuristic Assessment Rationale</div>
            <div id="riskReasons">No indicators flagged.</div>
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
              <h3 style="font-size: 0.92rem; font-weight: 600;">Detected Indicator Leads</h3>
              <button type="button" id="downloadReportBtn" class="btn btn-cyan-outline btn-sm">
                📥 Download Incident Report (.txt)
              </button>
            </div>

            <div class="table-container">
              <table class="findings-table" aria-label="Heuristic Findings">
                <thead>
                  <tr>
                    <th scope="col">Severity</th>
                    <th scope="col">Line #</th>
                    <th scope="col">Signature / Type</th>
                    <th scope="col">Matched Pattern Snippet</th>
                    <th scope="col">Log Excerpt</th>
                  </tr>
                </thead>
                <tbody id="findingsTableBody">
                  <!-- Injected via JavaScript -->
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Column 2: Incident Response Playbook Checklist -->
    <aside class="panel" aria-labelledby="checklist-title">
      <div class="panel-header">
        <h2 id="checklist-title" class="panel-title">Incident Response Checklist</h2>
        <button type="button" id="resetChecklistBtn" class="btn btn-ghost btn-sm">Reset</button>
      </div>

      <div class="panel-body">
        <p style="font-size: 0.8rem; color: var(--text-muted);">
          Align triage actions with standard identification, containment, and recovery milestones.
        </p>

        <!-- Progress Bar Indicator -->
        <div class="progress-section" role="region" aria-label="Checklist Progress">
          <div class="progress-info">
            <span>Readiness Progress</span>
            <span id=