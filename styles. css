/* CyberSentinel AI - Dashboard Styles */

:root {
--background: #07111f;
--panel: #101f32;
--border: #263b53;
--text: #e6f1ff;
--muted: #9bb0c8;
--cyan: #36d9f5;
--green: #48df9a;
--yellow: #ffd166;
--red: #ff647c;
}

* {
  box-sizing: border-box;
  }

body {
margin: 0;
padding: 24px;
background: var(--background);
color: var(--text);
font-family: Arial, sans-serif;
line-height: 1.6;
}

.container {
max-width: 1100px;
margin: auto;
}

header {
padding: 24px;
margin-bottom: 24px;
border: 1px solid var(--border);
border-radius: 16px;
background: var(--panel);
}

h1 {
margin: 0;
color: var(--cyan);
font-size: clamp(25px, 4vw, 38px);
}

.subtitle {
color: var(--muted);
}

.panel {
margin-bottom: 20px;
padding: 22px;
background: var(--panel);
border: 1px solid var(--border);
border-radius: 14px;
}

textarea,
input,
select {
width: 100%;
padding: 12px;
color: var(--text);
background: #07111f;
border: 1px solid var(--border);
border-radius: 8px;
font: inherit;
}

textarea {
min-height: 180px;
resize: vertical;
}

button {
padding: 11px 17px;
margin: 8px 8px 0 0;
color: #07111f;
background: var(--cyan);
border: none;
border-radius: 8px;
font-weight: bold;
cursor: pointer;
}

button:hover {
filter: brightness(1.12);
}

.grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
gap: 16px;
}

.metric {
padding: 18px;
background: #0b192a;
border: 1px solid var(--border);
border-radius: 12px;
}

.metric strong {
display: block;
margin-top: 8px;
font-size: 25px;
}

.low {
color: var(--green);
}

.medium {
color: var(--yellow);
}

.high {
color: var(--red);
}

pre,
code {
overflow-wrap: anywhere;
white-space: pre-wrap;
}

footer {
padding: 20px 0;
color: var(--muted);
text-align: center;
}

@media (max-width: 600px) {
body {
padding: 12px;
}

.panel,
header {
padding: 16px;
}
}