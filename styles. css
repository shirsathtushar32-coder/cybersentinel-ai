/* CyberSentinel AI - Security Operations Dashboard */

:root {
  --bg: #08111f;
  --panel: #111e30;
  --border: #263a50;
  --cyan: #22d3ee;
  --text: #e5edf7;
  --muted: #91a4ba;
  --green: #4ade80;
  --yellow: #facc15;
  --red: #fb7185;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
}

header {
  padding: 22px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  border-bottom: 1px solid var(--border);
  background: #0b1728;
}

.logo {
  color: var(--cyan);
  font-size: 23px;
  font-weight: bold;
}

.badge {
  border: 1px solid #17677b;
  color: var(--cyan);
  padding: 7px 11px;
  border-radius: 20px;
  font-size: 12px;
}

main {
  width: 92%;
  max-width: 1150px;
  margin: 30px auto;
}

.hero {
  margin-bottom: 25px;
}

h1 {
  font-size: 30px;
  margin-bottom: 8px;
}

p {
  color: var(--muted);
  line-height: 1.6;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px;
  min-width: 0;
}

.card h2 {
  font-size: 17px;
  margin-top: 0;
}

textarea {
  width: 100%;
  min-height: 180px;
  resize: vertical;
  background: #081321;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 13px;
  font: 14px/1.6 monospace;
}

button {
  cursor: pointer;
  border: 0;
  border-radius: 8px;
  padding: 11px 15px;
  margin: 8px 5px 0 0;
  font-weight: bold;
}

.primary {
  background: var(--cyan);
  color: #06121d;
}

.secondary {
  background: #263a50;
  color: white;
}

button:hover {
  opacity: 0.85;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.metric {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
  min-width: 0;
}

.metric strong {
  display: block;
  font-size: 25px;
  margin-top: 8px;
}

.small {
  color: var(--muted);
  font-size: 12px;
}

#risk {
  font-size: 23px;
  font-weight: bold;
  color: var(--cyan);
  margin: 15px 0;
}

#report {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: 13px/1.7 monospace;
  color: var(--green);
}

.checklist label {
  display: block;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  line-height: 1.5;
}

.checklist input {
  margin-right: 8px;
}

footer {
  text-align: center;
  padding: 25px;
  color: var(--muted);
  font-size: 12px;
}

.low {
  color: var(--green);
}

.medium {
  color: var(--yellow);
}

.high {
  color: var(--red);
}

@media (max-width: 700px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .metrics {
    grid-template-columns: 1fr;
  }

  h1 {
    font-size: 25px;
  }
}